    "allow-studio-scene-compile",
    "allow-studio-scene-save-plan",
    "allow-studio-scene-save-apply",
    "allow-studio-scene-export-plan",
    "allow-studio-scene-export-apply",
    "allow-studio-scene-bind-tokens",
    "allow-studio-scene-brief-create",
    "allow-studio-scene-packet-import",
    "allow-studio-scene-packet-export",
    "allow-studio-scene-review-create",
    "allow-studio-scene-candidate-verify",
    "allow-studio-scene-candidate-adopt"
  ]
