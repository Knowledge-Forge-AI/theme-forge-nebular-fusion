          "sidebarPrimaryForeground": "#260d1d",
          "sidebarAccent": "#35445a",
          "sidebarAccentForeground": "#e1f5ff",
          "sidebarBorder": "#455468",
          "sidebarRing": "#68c7ff"
        }
      }
    },
    "loom": {
      "tokenSetKey": "forge-console",
      "primaryFamily": "orange",
      "secondaryFamily": "cyan",
      "defaultAccent": "orange"
    }
  }
