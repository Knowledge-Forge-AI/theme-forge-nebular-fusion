      "hover": "#35445a",
      "active": "#465a72",
      "selection": "#1f4f6d",
      "selectionText": "#e1f5ff"
    }
  },
  "typography": {
    "body": {
      "family": "system-ui",
      "size": "16px",
      "lineHeight": 1.55
    },
    "heading": {
      "family": "system-ui",
      "size": "1.5rem",
      "lineHeight": 1.2
    },
    "ui": {
      "family": "monospace",
      "size": "0.9rem",
      "lineHeight": 1.35
    },
    "code": {
      "family": "monospace",
      "size": "0.9rem",
      "lineHeight": 1.5
    }
  },
  "radius": {
    "control": "4px",
    "surface": "8px",
    "overlay": "12px"
  },
  "spacing": {
    "base": "4px",
    "density": "comfortable"
  },
  "elevation": {
    "emphasis": "raised",
    "borderWidth": "2px",
    "borderStyle": "solid"
  },
  "focus": {
    "color": {
      "light": "#155e96",
      "dark": "#68c7ff"
    },
    "width": "3px",
    "offset": "3px"
  },
  "code": {
    "syntax": {
      "light": {
        "comment": "#5e6d80",
        "string": "#126a76",
        "number": "#915700",
        "constant": "#6441a5",
        "keyword": "#9c2f65",
        "function": "#155e96",
        "type": "#2f7658",
        "variable": "#131a24",
        "punctuation": "#526176",
        "tag": "#a33c3c",
        "attribute": "#795813"
      },
      "dark": {
        "comment": "#aebbd0",
        "string": "#7ce0dc",
        "number": "#ffc769",
        "constant": "#cbb4ff",
        "keyword": "#ff92c5",
        "function": "#80d2ff",
        "type": "#8ce5ae",
        "variable": "#f1f4f8",
        "punctuation": "#b8c7d9",
        "tag": "#ff9b9b",
        "attribute": "#f4d17b"
      }
    },
    "frame": "terminal",
    "copy": "standard"
  },
  "reading": {
    "measure": "48rem"
  },
  "navigation": {
    "prominence": "strong",
    "density": "comfortable"
